    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Marker1
        - /Marker2
        - /RobotModel1
        - /RobotModel1/Status1
        - /Path3
        - /MarkerArray2
